{
  "name": "claims-processing-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Insurance claims processing system — adjudication, lifecycle, disputes",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "git -C .. config core.hooksPath .githooks || true",
    "db:push": "prisma db push",
    "dev": "tsx watch src/http/server.ts",
    "start": "tsx src/http/server.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.4",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.1",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "fastify": "^5.9.0",
    "zod": "^4.4.3"
  }
}
